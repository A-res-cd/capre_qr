{
  "name": "organization-qr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker": "tsx scripts/worker.ts",
    "check:env": "tsx scripts/check-env.ts",
    "tunnel": "node scripts/public-tunnel.mjs",
    "tunnel:stop": "node scripts/public-tunnel.mjs --stop",
    "cf:build": "vite build --config cloudflare/vite.config.ts",
    "cf:dev": "npm run cf:build && wrangler dev --local --port 8787",
    "cf:check": "npm run cf:build && wrangler deploy --dry-run --outdir cloudflare/dist/worker",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:db:local": "wrangler d1 migrations apply capre_db --local",
    "cf:db:remote": "wrangler d1 migrations apply capre_db --remote",
    "cf:export:postgres": "tsx scripts/export-d1.ts",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fast-png": "^8.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "miniflare": "^5.20261012.1-beta",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
